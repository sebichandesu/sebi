# 이 파일을 복사해서 .streamlit/secrets.toml 로 저장하세요 (로컬 테스트용).
# Streamlit Cloud에 배포할 때는 이 내용을 앱 설정의 "Secrets" 칸에 그대로 붙여넣으면 됩니다.
#
# ===== 방법 1. Apps Script 방식 (추천, GCP 콘솔 필요 없음) =====
# apps_script_url: 구글 시트에 Apps Script를 배포하고 받은 웹앱 URL
# apps_script_key: apps_script.gs 파일의 SECRET_KEY와 동일한 값
#
# 아래 두 줄의 주석(#)을 지우고 값을 채우면 Apps Script 모드로 작동합니다.

# apps_script_url = "여기에_배포된_웹앱_URL_붙여넣기"
# apps_script_key = "여기에_apps_script.gs와_동일한_비밀번호"


# ===== 방법 2. Google Sheets 서비스 계정 방식 (고급, GCP 콘솔 필요) =====
# sheet_id: 구글 시트 주소창의 긴 URL 중간에 있는 ID
#   예) https://docs.google.com/spreadsheets/d/[이 부분이 sheet_id]/edit
# gcp_service_account: Google Cloud에서 다운로드한 서비스 계정 JSON 키의 내용
#
# 이 방법을 쓰려면 아래 주석을 지우고 값을 채우세요. (조직 정책으로 서비스 계정 키
# 생성이 막혀 있다면 이 방법 대신 위의 Apps Script 방식을 사용하세요.)

# sheet_id = "여기에_구글시트_ID_붙여넣기"
#
# [gcp_service_account]
# type = "service_account"
# project_id = "여기에_project_id"
# private_key_id = "여기에_private_key_id"
# private_key = "-----BEGIN PRIVATE KEY-----\n여기에_private_key_내용\n-----END PRIVATE KEY-----\n"
# client_email = "여기에_client_email"
# client_id = "여기에_client_id"
# auth_uri = "https://accounts.google.com/o/oauth2/auth"
# token_uri = "https://oauth2.googleapis.com/token"
# auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
# client_x509_cert_url = "여기에_client_x509_cert_url"
